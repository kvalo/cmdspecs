#!/bin/sh
#
# Run linters. Requires flake8, shellcheck and groff.

set -eu

flake8 cmdspecs tests/*.py

shellcheck check lint \
    tests/specs/*/*.script tests/specs/*/*.setup \
    tests/specs/*/*.teardown \
    tests/specs/*/setup tests/specs/*/setup_once \
    tests/specs/*/teardown tests/specs/*/teardown_once

# groff exits with 0 even when it warns, so fail on any output.
warnings=$(groff -man -ww -z cmdspecs.1 2>&1)
if [ -n "$warnings" ]; then
    echo "$warnings"
    exit 1
fi

echo "lint: ok"
