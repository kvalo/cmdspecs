VERSION = '0.34.0+git'


def version_string():
    '''Return VERSION, with a short hash of this script for git builds.

    A git build has the same VERSION for many different revisions, so
    the hash lets a bug report be matched to the exact script.

    '''

    if not VERSION.endswith('+git'):
        return VERSION
    try:
        with open(__file__, 'rb') as f:
            digest = hashlib.sha256(f.read()).hexdigest()[:8]
    except OSError:
        digest = 'nohash'
    return '%s.%s' % (VERSION, digest)


# The exit statuses follow those of pytest where that makes sense.
EXIT_OK = 0
EXIT_FAILED = 1
EXIT_INTERRUPTED = 2
EXIT_INTERNAL = 3
EXIT_USAGE = 4
EXIT_NO_TESTS = 5

# Seconds between the SIGTERM and the SIGKILL sent to a script which
# timed out, or on Windows the Ctrl-Break and the end of its job.
KILL_GRACE = 2

# Seconds to wait on Windows for the processes of a killed job to exit.
KILL_WAIT = 5

# Access rights for putting a process in a job object on Windows, and
# for waiting for it to exit.
PROCESS_TERMINATE = 0x0001
PROCESS_SET_QUOTA = 0x0100
SYNCHRONIZE = 0x00100000

# JobObjectBasicProcessIdList of QueryInformationJobObject().
JOB_OBJECT_BASIC_PROCESS_ID_LIST = 3
ERROR_MORE_DATA = 234


class ArgumentParser(argparse.ArgumentParser):

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(EXIT_USAGE, '%s: error: %s\n' % (self.prog, message))


def cat(filename):
    '''Return contents of file, or empty string if it doesn't exist.'''
    try:
        with open(filename) as f:
            return f.read()
    except FileNotFoundError:
        return ''


def read_lines(filename):
    '''Return lines of file as bytes, or [] if it doesn't exist.'''
    try:
        with open(filename, 'rb') as f:
            return f.readlines()
    except FileNotFoundError:
        return []


def remove(filename):
    '''Remove file, if it exists.'''
    with contextlib.suppress(FileNotFoundError):
        os.remove(filename)


# The signals of MSYS, which runs the scripts on Windows, where the
# signal module has other numbers and lacks most of these.
MSYS_SIGNALS = {1: 'SIGHUP', 2: 'SIGINT', 3: 'SIGQUIT', 4: 'SIGILL',
                5: 'SIGTRAP', 6: 'SIGABRT', 8: 'SIGFPE', 9: 'SIGKILL',
                11: 'SIGSEGV', 13: 'SIGPIPE', 14: 'SIGALRM', 15: 'SIGTERM'}


def describe_exit(code):
    '''Return exit code as text, with the signal name if it looks like one.'''
    if sys.platform == 'win32':
        name = MSYS_SIGNALS.get(code - 128)
    else:
        try:
            name = signal.Signals(code - 128).name
        except ValueError:
            name = None
    return '%d (%s)' % (code, name) if name else str(code)


def shell_exit_code(returncode):
    '''Return the exit code of a script as a shell shows it.

    A script killed by signal N gets -N from subprocess on Unix, and
    N * 256 from MSYS on Windows. A shell shows both as 128 + N.

    '''
    if returncode < 0:
        return 128 - returncode
    if sys.platform == 'win32' and returncode % 256 == 0 and \
            0 < returncode // 256 < 128:
        return 128 + returncode // 256
    return returncode


def mtime(filename):
    '''Return modification time of file in the format of diff -u.

    A filename of None stands for a missing file, which gets the epoch
    like in diff -N, in UTC so that it is the same everywhere.

    '''
    if filename is None:
        dt = datetime.datetime.fromtimestamp(0, datetime.timezone.utc)
    else:
        try:
            timestamp = os.stat(filename).st_mtime
        except OSError:
            return b''
        dt = datetime.datetime.fromtimestamp(timestamp).astimezone()
    return dt.strftime('%Y-%m-%d %H:%M:%S.%f %z').encode()


class TestCase:

    def __init__(self, name, path_prefix):
        self.name = name
        self.path_prefix = path_prefix


class TestDir:

    '''Contain information about a directory of test cases.'''

    dir_scripts = ('setup_once', 'setup', 'teardown', 'teardown_once')
    per_test_suffixes = ('script', 'stdin', 'stdout', 'stderr',
                         'exit', 'setup', 'teardown')

    def __init__(self):
        self.setup = None
        self.setup_once = None
        self.tests = []
        self.teardown = None
        self.teardown_once = None

    def scan(self, dirname, filenames=None):
        filenames = os.listdir(dirname) if filenames is None else filenames

        for name in self.dir_scripts:
            if name in filenames:
                full_path = os.path.join(dirname, name)
                setattr(self, name, full_path)

        prefixes = self.find_prefixes(filenames)
        for prefix in prefixes:
            test = TestCase(prefix, os.path.join(dirname, prefix))
            for suffix in self.per_test_suffixes:
                name = '%s.%s' % (prefix, suffix)
                if name in filenames:
                    value = os.path.join(dirname, name)
                else:
                    value = None
                setattr(test, suffix, value)
            self.tests.append(test)

    def find_prefixes(self, filenames):
        prefixes = set()
        for filename in filenames:
            for suffix in self.per_test_suffixes:
                suffix = '.' + suffix
                if filename.endswith(suffix):
                    prefix = filename[:-len(suffix)]
                    prefixes.add(prefix)
        return sorted(prefixes)


# Key in CommandTester.timings for the scripts that are not run for
# any one test.
ALL_TESTS = None


class TestFailure(Exception):

    def __init__(self, test, msg):
        self.test = test
        self.msg = msg

    def __str__(self):
        return self.msg


class ScriptTimeout(Exception):
    '''A script was killed because it ran longer than the timeout.'''


class ScriptError(Exception):

    def __init__(self, script_name, msg, output=''):
        self.msg = '%s: %s' % (script_name, msg)
        self.output = output

    def __str__(self):
        if not self.output:
            return self.msg
        return '%s\n%s' % (self.msg, self.output)


class ProcessGroup:

    '''A script running in a process group of its own.

    The group lets the processes which the script starts be killed
    with it, so that they don't keep running or keep its output files
    open.

    '''

    def __init__(self, args, **kwargs):
        self.proc = subprocess.Popen(args, start_new_session=True,
                                     **kwargs)

    def signal(self, sig):
        # macOS fails killpg with EPERM, not ESRCH, if the group has
        # only zombies left.
        with contextlib.suppress(ProcessLookupError, PermissionError):
            os.killpg(self.proc.pid, sig)

    def terminate(self):
        self.signal(signal.SIGTERM)

    def kill(self):
        self.signal(signal.SIGKILL)

    def close(self):
        pass


@functools.cache
def windows_kernel32():
    '''Return kernel32.dll with its job object functions declared.'''
    import ctypes
    from ctypes import wintypes
    kernel32 = ctypes.WinDLL('kernel32', use_last_error=True)
    kernel32.CreateJobObjectW.argtypes = [wintypes.LPVOID, wintypes.LPCWSTR]
    kernel32.CreateJobObjectW.restype = wintypes.HANDLE
    kernel32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL,
                                     wintypes.DWORD]
    kernel32.OpenProcess.restype = wintypes.HANDLE
    kernel32.AssignProcessToJobObject.argtypes = [wintypes.HANDLE,
                                                  wintypes.HANDLE]
    kernel32.TerminateJobObject.argtypes = [wintypes.HANDLE, wintypes.UINT]
    kernel32.QueryInformationJobObject.argtypes = [
        wintypes.HANDLE, ctypes.c_int, wintypes.LPVOID, wintypes.DWORD,
        wintypes.LPDWORD]
    kernel32.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
    kernel32.WaitForSingleObject.restype = wintypes.DWORD
    kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
    return kernel32


class WindowsProcessGroup(ProcessGroup):

    '''A script running in a process group and a job object of its own.

    Windows can't kill a process group. Under Git for Windows the
    processes which a script starts are not even its children for
    Windows, so taskkill /T misses them, but they stay in the job
    object of the script, which can be killed as a whole.

    '''

    def __init__(self, args, **kwargs):
        import ctypes
        self.kernel32 = windows_kernel32()
        self.job = self.kernel32.CreateJobObjectW(None, None)
        if not self.job:
            raise ctypes.WinError(ctypes.get_last_error())
        try:
            self.proc = subprocess.Popen(
                args, creationflags=subprocess.CREATE_NEW_PROCESS_GROUP,
                **kwargs)
        except BaseException:
            self.close()
            raise
        # What the script starts before it is in the job escapes the
        # job, but sh takes longer than this to start anything.
        process = self.kernel32.OpenProcess(
            PROCESS_SET_QUOTA | PROCESS_TERMINATE, False, self.proc.pid)
        if process:
            self.kernel32.AssignProcessToJobObject(self.job, process)
            self.kernel32.CloseHandle(process)

    def terminate(self):
        # Ctrl-Break is the nearest thing to SIGTERM. It can't be sent
        # if cmdspecs has no console.
        with contextlib.suppress(OSError):
            self.proc.send_signal(signal.CTRL_BREAK_EVENT)

    def process_ids(self):
        '''Return the ids of the processes in the job.'''
        import ctypes
        from ctypes import wintypes
        count = 16
        while True:
            class ProcessIdList(ctypes.Structure):
                _fields_ = [('assigned', wintypes.DWORD),
                            ('listed', wintypes.DWORD),
                            ('ids', ctypes.c_size_t * count)]
            info = ProcessIdList()
            if self.kernel32.QueryInformationJobObject(
                    self.job, JOB_OBJECT_BASIC_PROCESS_ID_LIST,
                    ctypes.byref(info), ctypes.sizeof(info), None):
                return info.ids[:info.listed]
            if ctypes.get_last_error() != ERROR_MORE_DATA:
                return []
            count *= 2

    def kill(self):
        # TerminateJobObject only starts to terminate the processes,
        # and they keep their files open until they have exited, so
        # wait for that. Open them before, so that their ids can't be
        # reused for other processes by then.
        processes = [self.kernel32.OpenProcess(SYNCHRONIZE, False, pid)
                     for pid in self.process_ids()]
        processes = [process for process in processes if process]
        try:
            self.kernel32.TerminateJobObject(self.job, 1)
            deadline = time.monotonic() + KILL_WAIT
            for process in processes:
                timeout = max(deadline - time.monotonic(), 0)
                self.kernel32.WaitForSingleObject(process,
                                                  int(timeout * 1000))
        finally:
            for process in processes:
                self.kernel32.CloseHandle(process)

    def close(self):
        self.kernel32.CloseHandle(self.job)


BOLD = '1'
RED = '31'
GREEN = '32'
YELLOW = '33'
CYAN = '36'


class Reporter:

    '''Report test progress and results like pytest does.

    Without verbose, show a dot (or F) per test on a line per test
    directory. With verbose, show each test on a line of its own.

    '''

    def __init__(self, output, verbose=False, color=False, width=None):
        self.output = output
        self.verbose = verbose
        self.color = color
        if width is None:
            width = shutil.get_terminal_size().columns
        self.width = width
        self.total = 0
        self.done = 0
        self.failed = 0
        self.dirname = None
        self.line_len = 0

    def paint(self, text, *codes):
        if not self.color or not codes:
            return text
        return '\x1b[%sm%s\x1b[0m' % (';'.join(codes), text)

    def write(self, text, *codes):
        self.output.write(self.paint(text, *codes))
        self.output.flush()
        if '\n' in text:
            self.line_len = len(text) - text.rindex('\n') - 1
        else:
            self.line_len += len(text)

    def sep(self, char, title, *codes):
        title = ' %s ' % title
        n = max(self.width - 1 - len(title), 2)
        left = char * (n // 2)
        right = char * (n - n // 2)
        self.write(left + title + right, *codes)
        self.write('\n')

    def main_color(self):
        return RED if self.failed else GREEN

    def end_line(self):
        if not self.line_len:
            return
        percent = '[%3d%%]' % (100 * self.done // max(self.total, 1))
        pad = self.width - 1 - self.line_len - len(percent)
        self.write(' ' * max(pad, 1))
        self.write(percent, self.main_color())
        self.write('\n')

    def start(self, tests, settings=()):
        '''Show the session header.

        settings is a list of (name, value) pairs to show below the
        platform line.

        '''

        self.total = len(tests)
        self.sep('=', 'cmdspecs session starts', BOLD)
        self.write('platform %s -- Python %s, cmdspecs %s\n' %
                   (sys.platform, platform.python_version(),
                    version_string()))
        for name, value in settings:
            self.write('%s: %s\n' % (name, value))
        self.write('collected %d test%s\n' %
                   (self.total, '' if self.total == 1 else 's'), BOLD)
        self.write('\n')

    def test_started(self, test):
        dirname = os.path.dirname(test.path_prefix)
        if self.verbose:
            self.write('%s::%s ' % (dirname, test.name))
        elif dirname != self.dirname:
            self.end_line()
            self.dirname = dirname
            self.write(dirname + ' ')

    def test_finished(self, test, failures):
        if not self.verbose and \
                self.line_len + 1 + len(' [100%]') >= self.width:
            self.end_line()
        self.done += 1
        if failures:
            self.failed += 1
        if self.verbose:
            if failures:
                self.write('FAILED', RED)
            else:
                self.write('PASSED', GREEN)
            self.end_line()
        elif failures:
            self.write('F', RED)
        else:
            self.write('.', GREEN)

    def finish(self, failed, passed, elapsed, errors=0):
        '''Show failures and the summary.

        failed is a list of (test, failures) pairs, and errors is the
        number of problems which are not tied to a test.

        '''

        self.end_line()
        if failed:
            self.write('\n')
            self.sep('=', 'FAILURES')
            for test, failures in failed:
                self.sep('_', test.name, RED, BOLD)
                for failure in failures:
                    msg = str(failure)
                    self.write(msg if msg.endswith('\n') else msg + '\n')
            self.sep('=', 'short test summary info', CYAN)
            for test, failures in failed:
                self.write('FAILED', RED)
                self.write(' %s - %s\n' %
                           (test.name, str(failures[0]).splitlines()[0]))

        counts = []
        if failed:
            counts.append('%d failed' % len(failed))
        if passed:
            counts.append('%d passed' % passed)
        if errors:
            counts.append('%d error%s' % (errors, 's' if errors > 1 else ''))
        if failed or errors:
            color = RED
        elif passed:
            color = GREEN
        else:
            color = YELLOW
        summary = '%s in %.2fs' % (', '.join(counts) or 'no tests ran',
                                   elapsed)
        self.sep('=', summary, color, BOLD)


class CommandTester:

    # Seconds a script may run, or None for no limit.
    timeout = None

    # The sh which runs the scripts on Windows, found when first needed.
    sh = None

    def make_parser(self):
        parser = ArgumentParser(
            description='Blackbox test Unix command line tools. '
                        'Each directory holds test cases: a NAME.script '
                        'file with optional NAME.stdin, .stdout, '
                        '.stderr, .exit, .setup and .teardown files, '
                        'plus shared setup and teardown scripts. '
                        'cmdspecs runs each script and compares its '
                        'output and exit status to the expected '
                        'files, showing differences on mismatch.',
            epilog='See cmdspecs(1) for more information. '
                   'Home page and bug reports: '
                   'https://github.com/kvalo/cmdspecs',
            prog='cmdspecs'
        )
        parser.add_argument('-t', '--test', action='append',
                            help='run only the test named TEST '
                                 '(can be given many times)',
                            metavar='TEST')
        parser.add_argument('-T', '--timings', action='store_true',
                            help='report how long each test takes')
        parser.add_argument('-o', '--timeout', type=float,
                            metavar='SECONDS',
                            help='kill a test or a setup or teardown '
                                 'script which runs longer than SECONDS '
                                 'and report it as failed')
        parser.add_argument('-k', '--keep', action='store_true',
                            help='keep the temporary directory if a '
                                 'test or a script fails, or on interrupt')
        parser.add_argument('-s', '--no-capture', action='store_true',
                            help='do not capture the output of setup '
                                 'and teardown scripts')
        parser.add_argument('-v', '--verbose', action='store_true',
                            help='show the name and result of each test')
        parser.add_argument('-C', '--color', choices=['auto', 'yes', 'no'],
                            default='auto',
                            help='color the output; auto (the default) '
                                 'colors only on a terminal')
        parser.add_argument('-V', '--version', action='version',
                            version='%(prog)s ' + version_string())
        parser.add_argument('dirnames', nargs='+',
                            help='directories containing the test cases')
        return parser

    def run(self, argv=None):
        self.output = sys.stdout
        # Test output shown in the diffs may have characters which the
        # encoding of the output doesn't have.
        self.output.reconfigure(errors='backslashreplace')

        parser = self.make_parser()
        args = parser.parse_args(argv)
        if args.timeout is not None and args.timeout <= 0:
            parser.error('argument -o/--timeout: must be greater than 0')
        self.timeout = args.timeout
        if sys.platform == 'win32':
            # Once here rather than as a failure of every test.
            self.find_sh()

        # The time each script took as (seconds, script) pairs, and the
        # time each test took in total. The keys are path prefixes of
        # the tests.
        self.timings = {}
        self.test_timings = {}
        # Failures of setup_once and teardown_once scripts.
        self.errors = []
        self.capture = not args.no_capture
        suite_started = time.monotonic()

        try:
            testdirs = self.load_tests(args.dirnames, args.test or [])
        except OSError as e:
            parser.error('%s: %s' % (e.filename, e.strerror))
        tests = [test for td in testdirs for test in td.tests]
        names = set(test.name for test in tests)
        missing = [name for name in args.test or [] if name not in names]
        if missing:
            parser.error('no such test: %s' % ', '.join(missing))
        # With --test a directory without the requested tests is normal.
        if not args.test:
            for dirname, td in zip(args.dirnames, testdirs):
                if not td.tests:
                    self.errors.append('%s: no tests found' % dirname)
        empty_dirs = len(self.errors)

        self.setup_reporter(args)
        self.setup_tempdir()
        keep_tempdir = False
        try:
            settings = [('srcdir', os.getcwd()),
                        ('datadir', self.datadir),
                        ('keep', 'yes' if args.keep else 'no'),
                        ('testdirs', ', '.join(args.dirnames))]
            if args.test:
                settings.append(('tests', ', '.join(args.test)))
            if args.timeout is not None:
                settings.append(('timeout', '%g seconds' % args.timeout))
            self.reporter.start(tests, settings)

            failed = self.run_tests(testdirs)
            run_failed = bool(failed) or len(self.errors) > empty_dirs
            keep_tempdir = run_failed and args.keep
        except BaseException:
            # Interrupted or crashed, so there is no summary to show the
            # location in.
            if args.keep:
                keep_tempdir = True
                sys.stderr.write('Test work area: %s\n' % self.tempdir)
            raise
        finally:
            if not keep_tempdir:
                self.cleanup_tempdir()

        elapsed = time.monotonic() - suite_started

        self.reporter.finish(failed, self.reporter.done - len(failed),
                             elapsed, len(self.errors))

        if keep_tempdir:
            self.output.write('Test work area: %s\n' % self.tempdir)

        if args.timings:
            self.report_timings(elapsed)

        for error in self.errors:
            sys.stderr.write('cmdspecs: %s\n' % str(error).rstrip('\n'))

        if run_failed:
            sys.exit(EXIT_FAILED)
        if empty_dirs:
            sys.exit(EXIT_NO_TESTS)

    def run_tests(self, testdirs):
        '''Run the tests and return a list of (test, failures) pairs.'''
        failed = []
        for td in testdirs:
            if not td.tests:
                continue
            try:
                self.run_script(td.setup_once)
            except ScriptError as e:
                # The tests can't be trusted without their setup, so
                # stop here.
                self.errors.append(e)
                break
            for test in td.tests:
                started = time.monotonic()
                self.reporter.test_started(test)
                failures = []
                if self.run_hook(td.setup, test, failures):
                    failures += self.run_test(test)
                    self.run_hook(td.teardown, test, failures)
                self.reporter.test_finished(test, failures)
                if failures:
                    failed.append((test, failures))
                self.test_timings[test.path_prefix] = \
                    time.monotonic() - started
            try:
                self.run_script(td.teardown_once)
            except ScriptError as e:
                self.errors.append(e)
        return failed

    def setup_reporter(self, args):
        if args.color == 'auto':
            color = (self.output.isatty() and
                     not os.environ.get('NO_COLOR'))
        else:
            color = args.color == 'yes'
        self.reporter = Reporter(self.output, verbose=args.verbose,
                                 color=color)

    def load_tests(self, dirnames, names):
        '''Return a TestDir for each directory.

        If names is not empty, load only the tests with those names.

        '''
        testdirs = []
        for dirname in dirnames:
            filenames = os.listdir(dirname)
            if names:
                filenames = self.find_requested_tests(filenames, names)
            td = TestDir()
            td.scan(dirname, filenames)
            testdirs.append(td)
        return testdirs

    def find_requested_tests(self, filenames, names):
        wanted = set(TestDir.dir_scripts)
        for name in names:
            for suffix in TestDir.per_test_suffixes:
                wanted.add('%s.%s' % (name, suffix))
        return [x for x in filenames if x in wanted]

    def setup_tempdir(self):
        self.tempdir = tempfile.mkdtemp(prefix='cmdspecs-')
        self.datadir = os.path.join(self.tempdir, 'data')
        os.mkdir(self.datadir)

    def cleanup_tempdir(self):
        # The tests may have left directories without permissions
        # behind, and those can't be removed as is.
        for dirpath, dirnames, _ in os.walk(self.tempdir):
            for name in dirnames:
                path = os.path.join(dirpath, name)
                if not os.path.islink(path):
                    with contextlib.suppress(OSError):
                        os.chmod(path, 0o700)
        shutil.rmtree(self.tempdir, ignore_errors=True)
        if os.path.exists(self.tempdir):
            sys.stderr.write('cmdspecs: could not remove %s\n' %
                             self.tempdir)

    def find_sh(self):
        '''Return the sh which runs the scripts on Windows.'''
        if not self.sh:
            self.sh = shutil.which('sh')
        if not self.sh:
            raise FileNotFoundError(
                errno.ENOENT, 'sh not found in PATH; on Windows cmdspecs '
                'needs the sh of Git for Windows or MSYS2')
        return self.sh

    def script_command(self, script_name):
        '''Return the command which runs a script.

        Unix runs the interpreter named on the #! line of a script.
        Windows ignores that line, but the exec of the sh in Git for
        Windows and MSYS2 handles it like Unix does, so let that sh
        run the script.

        '''
        if sys.platform != 'win32':
            return [script_name]
        return [self.find_sh(), '-c', 'exec "$0"', script_name]

    def run_process(self, script_name, test, kill_leftovers=False,
                    **kwargs):
        '''Run a script and return its exit code.

        A script killed by signal N returns 128 + N, like in a shell.

        The script gets a process group of its own, so that on a
        timeout or an interrupt its children can be killed too and
        don't keep the output files open. Raise ScriptTimeout if the
        script runs longer than self.timeout.

        Windows can't remove a file which a process has open, so there
        kill_leftovers also kills what the script left running when it
        exited, as that would keep the output files of the test open.

        '''
        if sys.platform == 'win32':
            group_class = WindowsProcessGroup
        else:
            group_class = ProcessGroup
        group = group_class(self.script_command(script_name),
                            env=self.add_to_env(test), **kwargs)
        try:
            returncode = group.proc.wait(timeout=self.timeout)
            if kill_leftovers and sys.platform == 'win32':
                group.kill()
            return shell_exit_code(returncode)
        except subprocess.TimeoutExpired:
            self.kill_group(group)
            raise ScriptTimeout()
        except BaseException:
            self.kill_group(group)
            raise
        finally:
            group.close()

    def kill_group(self, group):
        '''Kill a script with what it started and wait for it to exit.'''
        for stop, grace in [(group.terminate, KILL_GRACE),
                            (group.kill, None)]:
            stop()
            try:
                group.proc.wait(timeout=grace)
                break
            except subprocess.TimeoutExpired:
                pass
        # Also kill what the script left running after it exited.
        group.kill()

    def run_script(self, script_name, test=None):
        '''Run a setup or teardown script, if there is one.

        test is None for the scripts which are not run for any one
        test.

        '''
        if not script_name:
            return
        started = time.monotonic()
        # Capture to a file rather than a pipe, as a daemon started by
        # the script may keep a pipe open and make us wait for it.
        with contextlib.ExitStack() as stack:
            if self.capture:
                output = stack.enter_context(
                    tempfile.TemporaryFile(dir=self.tempdir))
            else:
                output = None
            msg = None
            try:
                returncode = self.run_process(
                    script_name, test, stdin=subprocess.DEVNULL,
                    stdout=output,
                    stderr=subprocess.STDOUT if output else None)
                if returncode:
                    msg = 'exited with %s' % describe_exit(returncode)
            except ScriptTimeout:
                msg = 'timed out after %g seconds' % self.timeout
            except OSError as e:
                raise ScriptError(script_name, e.strerror)
            if msg:
                text = ''
                if output:
                    output.seek(0)
                    text = output.read().decode('utf-8', 'backslashreplace')
                raise ScriptError(script_name, msg, text)
        key = test.path_prefix if test else ALL_TESTS
        self.timings.setdefault(key, []).append(
            (time.monotonic() - started, script_name))

    def run_hook(self, script_name, test, failures):
        '''Run a setup or teardown script of a test.

        If the script fails, add that to failures and return False.

        '''
        try:
            self.run_script(script_name, test)
        except ScriptError as e:
            failures.append(TestFailure(test, str(e)))
            return False
        return True

    def add_to_env(self, test):
        env = dict(os.environ)
        env['SRCDIR'] = os.getcwd()
        env['DATADIR'] = self.datadir
        env['TESTNAME'] = test.name if test else ''
        return env

    def run_test(self, test):
        if not test.script:
            return [TestFailure(test, 'missing %s.script' % test.name)]

        try:
            expected_exit = int(cat(test.exit).strip() or '0') \
                if test.exit else 0
        except (OSError, ValueError) as e:
            return [TestFailure(test, 'invalid %s: %s' % (test.exit, e))]

        failures = []
        if not self.run_hook(test.setup, test, failures):
            return failures

        stdout_name = test.path_prefix + '.stdout-actual'
        stderr_name = test.path_prefix + '.stderr-actual'
        run_error = None
        try:
            exit_code = self.run_command(test, stdout_name, stderr_name)
        except OSError as e:
            run_error = e

        # Run the teardown even if the test failed, but report its
        # failure last as it's the least interesting one.
        teardown_failures = []
        self.run_hook(test.teardown, test, teardown_failures)

        if run_error:
            # Comparing output and exit code is pointless when the
            # script never ran.
            remove(stdout_name)
            remove(stderr_name)
            msg = run_error.strerror
            if run_error.filename not in (None, test.script):
                msg = '%s: %s' % (run_error.filename, msg)
            failures.append(TestFailure(test, 'could not run %s: %s' %
                                        (test.script, msg)))
            return failures + teardown_failures

        outputs = [('stdout', test.stdout, stdout_name),
                   ('stderr', test.stderr, stderr_name)]
        for what, expected_name, actual_name in outputs:
            diff_name = '%s.%s-diff' % (test.path_prefix, what)
            diff = self.diff(expected_name, actual_name, diff_name)
            if diff:
                failures.append(TestFailure(test, '%s diff:\n%s' %
                                            (what, diff)))
            else:
                remove(actual_name)

        if exit_code is None:
            # First, as that is the cause of any output differences.
            failures.insert(0, TestFailure(
                test, 'timed out after %g seconds' % self.timeout))
        elif exit_code != expected_exit:
            failures.append(TestFailure(test,
                                        'got exit code %s, expected %s' %
                                        (describe_exit(exit_code),
                                         expected_exit)))

        return failures + teardown_failures

    def run_command(self, test, stdout_name, stderr_name):
        '''Run the script of a test and return its exit code.

        Return None if the script timed out.

        '''
        with contextlib.ExitStack() as stack:
            stdout = stack.enter_context(open(stdout_name, 'wb'))
            stderr = stack.enter_context(open(stderr_name, 'wb'))
            if test.stdin:
                stdin = stack.enter_context(open(test.stdin, 'rb'))
            else:
                stdin = subprocess.DEVNULL
            try:
                return self.run_process(test.script, test, stdin=stdin,
                                        stdout=stdout, stderr=stderr,
                                        kill_leftovers=True)
            except ScriptTimeout:
                return None

    def diff(self, expected_name, actual_name, diff_name):
        '''Write a diff of two files to a file and return it.

        If the files don't differ, return an empty string and make
        sure that there's no diff file.

        An expected_name of None means that the test has no expected
        file, so the output should be empty. It is shown as /dev/null,
        without reading that, as Windows doesn't have it.

        '''

        # Compare bytes, as the output need not be valid UTF-8. Keep
        # the newlines, so that a missing one at the end is a difference.
        expected_lines = read_lines(expected_name) if expected_name else []
        actual_lines = read_lines(actual_name)
        if expected_lines == actual_lines:
            remove(diff_name)
            return ''

        # Like diff -u, mark a last line without a newline.
        diff_lines = []
        fromfile = os.fsencode(expected_name or '/dev/null')
        for line in difflib.diff_bytes(difflib.unified_diff,
                                       expected_lines,
                                       actual_lines,
                                       fromfile=fromfile,
                                       tofile=os.fsencode(actual_name),
                                       fromfiledate=mtime(expected_name),
                                       tofiledate=mtime(actual_name),
                                       lineterm=b'\n'):
            if not line.endswith(b'\n'):
                line += b'\n\\ No newline at end of file\n'
            diff_lines.append(line)

        with open(diff_name, 'wb') as f:
            f.writelines(diff_lines)

        # Show invalid UTF-8 as backslash escapes.
        return b''.join(diff_lines).decode('utf-8', 'backslashreplace')

    def report_timings(self, elapsed):

        def report(key, title, total):
            self.output.write('  %s: %.1f s\n' % (title, total))
            for secs, script in sorted(self.timings.get(key, [])):
                self.output.write('    %4.1f %s\n' % (secs, script))

        self.output.write('Timings (in seconds):\n')
        report(ALL_TESTS, 'whole test suite', elapsed)
        for name, secs in sorted(self.test_timings.items()):
            report(name, name, secs)


def main():
    try:
        CommandTester().run()
    except KeyboardInterrupt:
        sys.stderr.write('\ncmdspecs: interrupted\n')
        sys.exit(EXIT_INTERRUPTED)
    except BrokenPipeError:
        # Python flushes stdout at exit, so point it elsewhere to avoid
        # a second error.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(EXIT_FAILED)
    except OSError as e:
        sys.stderr.write('cmdspecs: %s\n' % (
            '%s: %s' % (e.filename, e.strerror) if e.filename
            else e.strerror or e))
        sys.exit(EXIT_FAILED)
    except Exception as e:
        traceback.print_exc()
        sys.stderr.write('cmdspecs: internal error: %s: %s\n' %
                         (type(e).__name__, e))
        sys.exit(EXIT_INTERNAL)


if __name__ == '__main__':
    main()
