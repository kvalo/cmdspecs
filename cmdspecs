import time


VERSION = '0.33+git'


def cat(filename):
    '''Return contents of file, or empty string if it doesn't exist.'''
    try:
        with open(filename) as f:
            return f.read()
    except FileNotFoundError:
        return ''


def read_lines(filename):
    '''Return lines of file as bytes, or [] if it doesn't exist.'''
    try:
        with open(filename, 'rb') as f:
            return f.readlines()
    except FileNotFoundError:
        return []


def remove(filename):
    '''Remove file, if it exists.'''
    with contextlib.suppress(FileNotFoundError):
        os.remove(filename)


def mtime(filename):
    '''Return modification time of file in the format of diff -u.'''
    try:
        timestamp = os.stat(filename).st_mtime
    except OSError:
        return b''
    dt = datetime.datetime.fromtimestamp(timestamp).astimezone()
    return dt.strftime('%Y-%m-%d %H:%M:%S.%f %z').encode()


class TestCase:

    def __init__(self, name, path_prefix):
        self.name = name
        self.path_prefix = path_prefix


class TestDir:

    '''Contain information about a directory of test cases.'''

    dir_scripts = ('setup_once', 'setup', 'teardown', 'teardown_once')
    per_test_suffixes = ('script', 'stdin', 'stdout', 'stderr',
                         'exit', 'setup', 'teardown')

    def __init__(self):
        self.setup = None
        self.setup_once = None
        self.tests = []
        self.teardown = None
        self.teardown_once = None

    def scan(self, dirname, filenames=None):
        filenames = os.listdir(dirname) if filenames is None else filenames

        for name in self.dir_scripts:
            if name in filenames:
                full_path = os.path.join(dirname, name)
                setattr(self, name, full_path)

        prefixes = self.find_prefixes(filenames)
        for prefix in prefixes:
            test = TestCase(prefix, os.path.join(dirname, prefix))
            for suffix in self.per_test_suffixes:
                name = '%s.%s' % (prefix, suffix)
                if name in filenames:
                    value = os.path.join(dirname, name)
                else:
                    value = None
                setattr(test, suffix, value)
            self.tests.append(test)

    def find_prefixes(self, filenames):
        prefixes = set()
        for filename in filenames:
            for suffix in self.per_test_suffixes:
                suffix = '.' + suffix
                if filename.endswith(suffix):
                    prefix = filename[:-len(suffix)]
                    prefixes.add(prefix)
        return sorted(prefixes)


# Key in CommandTester.timings for the scripts that are not run for
# any one test.
ALL_TESTS = None


class TestFailure(Exception):

    def __init__(self, test, msg):
        self.test = test
        self.msg = msg

    def __str__(self):
        return self.msg


class ScriptError(Exception):

    def __init__(self, script_name, msg):
        self.msg = '%s: %s' % (script_name, msg)

    def __str__(self):
        return self.msg


BOLD = '1'
RED = '31'
GREEN = '32'
YELLOW = '33'
CYAN = '36'


class Reporter:

    '''Report test progress and results like pytest does.

    Without verbose, show a dot (or F) per test on a line per test
    directory. With verbose, show each test on a line of its own.

    '''

    def __init__(self, output, verbose=False, color=False, width=None):
        self.output = output
        self.verbose = verbose
        self.color = color
        if width is None:
            width = shutil.get_terminal_size().columns
        self.width = width
        self.total = 0
        self.done = 0
        self.failed = 0
        self.dirname = None
        self.line_len = 0

    def paint(self, text, *codes):
        if not self.color or not codes:
            return text
        return '\x1b[%sm%s\x1b[0m' % (';'.join(codes), text)

    def write(self, text, *codes):
        self.output.write(self.paint(text, *codes))
        self.output.flush()
        if '\n' in text:
            self.line_len = len(text) - text.rindex('\n') - 1
        else:
            self.line_len += len(text)

    def sep(self, char, title, *codes):
        title = ' %s ' % title
        n = max(self.width - 1 - len(title), 2)
        left = char * (n // 2)
        right = char * (n - n // 2)
        self.write(left + title + right, *codes)
        self.write('\n')

    def main_color(self):
        return RED if self.failed else GREEN

    def end_line(self):
        if not self.line_len:
            return
        percent = '[%3d%%]' % (100 * self.done // max(self.total, 1))
        pad = self.width - 1 - self.line_len - len(percent)
        self.write(' ' * max(pad, 1))
        self.write(percent, self.main_color())
        self.write('\n')

    def start(self, tests):
        self.total = len(tests)
        self.sep('=', 'test session starts', BOLD)
        self.write('platform %s -- Python %s, cmdspecs %s\n' %
                   (sys.platform, platform.python_version(), VERSION))
        self.write('collected %d test%s\n' %
                   (self.total, '' if self.total == 1 else 's'), BOLD)
        self.write('\n')

    def test_started(self, test):
        dirname = os.path.dirname(test.path_prefix)
        if self.verbose:
            self.write('%s::%s ' % (dirname, test.name))
        elif dirname != self.dirname:
            self.end_line()
            self.dirname = dirname
            self.write(dirname + ' ')

    def test_finished(self, test, failures):
        if not self.verbose and \
                self.line_len + 1 + len(' [100%]') >= self.width:
            self.end_line()
        self.done += 1
        if failures:
            self.failed += 1
        if self.verbose:
            if failures:
                self.write('FAILED', RED)
            else:
                self.write('PASSED', GREEN)
            self.end_line()
        elif failures:
            self.write('F', RED)
        else:
            self.write('.', GREEN)

    def finish(self, failed, passed, elapsed):
        '''Show failures and the summary.

        failed is a list of (test, failures) pairs.

        '''

        self.end_line()
        if failed:
            self.write('\n')
            self.sep('=', 'FAILURES')
            for test, failures in failed:
                self.sep('_', test.name, RED, BOLD)
                for failure in failures:
                    msg = str(failure)
                    self.write(msg if msg.endswith('\n') else msg + '\n')
            self.sep('=', 'short test summary info', CYAN)
            for test, failures in failed:
                self.write('FAILED', RED)
                self.write(' %s - %s\n' %
                           (test.name, str(failures[0]).splitlines()[0]))

        counts = []
        if failed:
            counts.append('%d failed' % len(failed))
        if passed:
            counts.append('%d passed' % passed)
        if failed:
            color = RED
        elif passed:
            color = GREEN
        else:
            color = YELLOW
        summary = '%s in %.2fs' % (', '.join(counts) or 'no tests ran',
                                   elapsed)
        self.sep('=', summary, color, BOLD)


class CommandTester:

    def make_parser(self):
        parser = argparse.ArgumentParser(
            description='blackbox testing of Unix command line tools',
            prog='cmdspecs'
        )
        parser.add_argument('-c', '--command',
                            help='ignored for backwards compatibility')
        parser.add_argument('-t', '--test', action='append',
                            help='run only TEST '
                                 '(can be given many times)',
                            metavar='TEST')
        parser.add_argument('--timings', action='store_true',
                            help='report how long each test takes')
        parser.add_argument('-k', '--keep', action='store_true',
                            help='keep temporary data on failure')
        parser.add_argument('-v', '--verbose', action='store_true',
                            help='show the name and result of each test')
        parser.add_argument('--color', choices=['auto', 'yes', 'no'],
                            default='auto',
                            help='color the output: auto (the default) '
                                 'colors it on a terminal')
        parser.add_argument('--version', action='version',
                            version='%(prog)s ' + VERSION)
        parser.add_argument('dirnames', nargs='+',
                            help='directories containing tests')
        return parser

    def run(self, argv=None):
        self.output = sys.stdout
        # Test output shown in the diffs may have characters which the
        # encoding of the output doesn't have.
        self.output.reconfigure(errors='backslashreplace')

        parser = self.make_parser()
        args = parser.parse_args(argv)

        # The time each script took as (seconds, script) pairs, and the
        # time each test took in total. The keys are path prefixes of
        # the tests.
        self.timings = {}
        self.test_timings = {}
        # Failures of setup_once and teardown_once scripts.
        self.errors = []
        suite_started = time.monotonic()

        try:
            testdirs = self.load_tests(args.dirnames, args.test or [])
        except OSError as e:
            parser.error('%s: %s' % (e.filename, e.strerror))
        tests = [test for td in testdirs for test in td.tests]
        names = set(test.name for test in tests)
        missing = [name for name in args.test or [] if name not in names]
        if missing:
            parser.error('no such test: %s' % ', '.join(missing))

        self.setup_reporter(args)
        self.reporter.start(tests)

        self.setup_tempdir()
        keep_tempdir = False
        try:
            failed = self.run_tests(testdirs)
            keep_tempdir = bool(failed) and args.keep
        finally:
            if not keep_tempdir:
                self.cleanup_tempdir()

        elapsed = time.monotonic() - suite_started

        self.reporter.finish(failed, self.reporter.done - len(failed),
                             elapsed)

        if keep_tempdir:
            self.output.write('Test work area: %s\n' % self.tempdir)

        if args.timings:
            self.report_timings(elapsed)

        for error in self.errors:
            sys.stderr.write('cmdspecs: %s\n' % error)

        if failed or self.errors:
            sys.exit(1)

    def run_tests(self, testdirs):
        '''Run the tests and return a list of (test, failures) pairs.'''
        failed = []
        for td in testdirs:
            if not td.tests:
                continue
            try:
                self.run_script(td.setup_once)
            except ScriptError as e:
                # The tests can't be trusted without their setup, so
                # stop here.
                self.errors.append(e)
                break
            for test in td.tests:
                started = time.monotonic()
                self.reporter.test_started(test)
                failures = []
                if self.run_hook(td.setup, test, failures):
                    failures += self.run_test(test)
                    self.run_hook(td.teardown, test, failures)
                self.reporter.test_finished(test, failures)
                if failures:
                    failed.append((test, failures))
                self.test_timings[test.path_prefix] = \
                    time.monotonic() - started
            try:
                self.run_script(td.teardown_once)
            except ScriptError as e:
                self.errors.append(e)
        return failed

    def setup_reporter(self, args):
        if args.color == 'auto':
            color = (self.output.isatty() and
                     not os.environ.get('NO_COLOR'))
        else:
            color = args.color == 'yes'
        self.reporter = Reporter(self.output, verbose=args.verbose,
                                 color=color)

    def load_tests(self, dirnames, names):
        '''Return a TestDir for each directory.

        If names is not empty, load only the tests with those names.

        '''
        testdirs = []
        for dirname in dirnames:
            filenames = os.listdir(dirname)
            if names:
                filenames = self.find_requested_tests(filenames, names)
            td = TestDir()
            td.scan(dirname, filenames)
            testdirs.append(td)
        return testdirs

    def find_requested_tests(self, filenames, names):
        wanted = set(TestDir.dir_scripts)
        for name in names:
            for suffix in TestDir.per_test_suffixes:
                wanted.add('%s.%s' % (name, suffix))
        return [x for x in filenames if x in wanted]

    def setup_tempdir(self):
        self.tempdir = tempfile.mkdtemp()
        self.datadir = os.path.join(self.tempdir, 'data')
        os.mkdir(self.datadir)

    def cleanup_tempdir(self):
        # The tests may have left directories without permissions
        # behind, and those can't be removed as is.
        for dirpath, dirnames, _ in os.walk(self.tempdir):
            for name in dirnames:
                path = os.path.join(dirpath, name)
                if not os.path.islink(path):
                    with contextlib.suppress(OSError):
                        os.chmod(path, 0o700)
        shutil.rmtree(self.tempdir, ignore_errors=True)
        if os.path.exists(self.tempdir):
            sys.stderr.write('cmdspecs: could not remove %s\n' %
                             self.tempdir)

    def run_script(self, script_name, test=None):
        '''Run a setup or teardown script, if there is one.

        test is None for the scripts which are not run for any one
        test.

        '''
        if not script_name:
            return
        started = time.monotonic()
        try:
            subprocess.check_call([script_name],
                                  env=self.add_to_env(test),
                                  stdin=subprocess.DEVNULL)
        except subprocess.CalledProcessError as e:
            raise ScriptError(script_name,
                              'exited with %d' % e.returncode)
        except OSError as e:
            raise ScriptError(script_name, e.strerror)
        key = test.path_prefix if test else ALL_TESTS
        self.timings.setdefault(key, []).append(
            (time.monotonic() - started, script_name))

    def run_hook(self, script_name, test, failures):
        '''Run a setup or teardown script of a test.

        If the script fails, add that to failures and return False.

        '''
        try:
            self.run_script(script_name, test)
        except ScriptError as e:
            failures.append(TestFailure(test, str(e)))
            return False
        return True

    def add_to_env(self, test):
        env = dict(os.environ)
        env['SRCDIR'] = os.getcwd()
        env['DATADIR'] = self.datadir
        env['TESTNAME'] = test.name if test else ''
        return env

    def run_test(self, test):
        if not test.script:
            return [TestFailure(test, 'missing %s.script' % test.name)]

        try:
            expected_exit = int(cat(test.exit).strip() or '0') \
                if test.exit else 0
        except (OSError, ValueError) as e:
            return [TestFailure(test, 'invalid %s: %s' % (test.exit, e))]

        failures = []
        if not self.run_hook(test.setup, test, failures):
            return failures

        stdout_name = test.path_prefix + '.stdout-actual'
        stderr_name = test.path_prefix + '.stderr-actual'
        run_error = None
        try:
            exit_code = self.run_command(test, stdout_name, stderr_name)
        except OSError as e:
            run_error = e

        # Run the teardown even if the test failed, but report its
        # failure last as it's the least interesting one.
        teardown_failures = []
        self.run_hook(test.teardown, test, teardown_failures)

        if run_error:
            # Comparing output and exit code is pointless when the
            # script never ran.
            remove(stdout_name)
            remove(stderr_name)
            msg = run_error.strerror
            if run_error.filename not in (None, test.script):
                msg = '%s: %s' % (run_error.filename, msg)
            failures.append(TestFailure(test, 'could not run %s: %s' %
                                        (test.script, msg)))
            return failures + teardown_failures

        outputs = [('stdout', test.stdout, stdout_name),
                   ('stderr', test.stderr, stderr_name)]
        for what, expected_name, actual_name in outputs:
            diff_name = '%s.%s-diff' % (test.path_prefix, what)
            diff = self.diff(expected_name or '/dev/null', actual_name,
                             diff_name)
            if diff:
                failures.append(TestFailure(test, '%s diff:\n%s' %
                                            (what, diff)))
            else:
                remove(actual_name)

        if exit_code != expected_exit:
            failures.append(TestFailure(test,
                                        'got exit code %s, expected %s' %
                                        (exit_code, expected_exit)))

        return failures + teardown_failures

    def run_command(self, test, stdout_name, stderr_name):
        '''Run the script of a test and return its exit code.'''
        with contextlib.ExitStack() as stack:
            stdout = stack.enter_context(open(stdout_name, 'wb'))
            stderr = stack.enter_context(open(stderr_name, 'wb'))
            if test.stdin:
                stdin = stack.enter_context(open(test.stdin, 'rb'))
            else:
                stdin = subprocess.DEVNULL
            result = subprocess.run([test.script],
                                    env=self.add_to_env(test),
                                    stdin=stdin,
                                    stdout=stdout,
                                    stderr=stderr,
                                    check=False)
            return result.returncode

    def diff(self, expected_name, actual_name, diff_name):
        '''Write a diff of two files to a file and return it.

        If the files don't differ, return an empty string and make
        sure that there's no diff file.

        '''

        # Compare bytes, as the output need not be valid UTF-8. Keep
        # the newlines, so that a missing one at the end is a difference.
        expected_lines = read_lines(expected_name)
        actual_lines = read_lines(actual_name)
        if expected_lines == actual_lines:
            remove(diff_name)
            return ''

        # Like diff -u, mark a last line without a newline.
        diff_lines = []
        for line in difflib.diff_bytes(difflib.unified_diff,
                                       expected_lines,
                                       actual_lines,
                                       fromfile=os.fsencode(expected_name),
                                       tofile=os.fsencode(actual_name),
                                       fromfiledate=mtime(expected_name),
                                       tofiledate=mtime(actual_name),
                                       lineterm=b'\n'):
            if not line.endswith(b'\n'):
                line += b'\n\\ No newline at end of file\n'
            diff_lines.append(line)

        with open(diff_name, 'wb') as f:
            f.writelines(diff_lines)

        # Show invalid UTF-8 as backslash escapes.
        return b''.join(diff_lines).decode('utf-8', 'backslashreplace')

    def report_timings(self, elapsed):

        def report(key, title, total):
            self.output.write('  %s: %.1f s\n' % (title, total))
            for secs, script in sorted(self.timings.get(key, [])):
                self.output.write('    %4.1f %s\n' % (secs, script))

        self.output.write('Timings (in seconds):\n')
        report(ALL_TESTS, 'whole test suite', elapsed)
        for name, secs in sorted(self.test_timings.items()):
            report(name, name, secs)


def main():
    try:
        CommandTester().run()
    except KeyboardInterrupt:
        sys.stderr.write('\ncmdspecs: interrupted\n')
        sys.exit(130)
    except BrokenPipeError:
        # Python flushes stdout at exit, so point it elsewhere to avoid
        # a second error.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)


if __name__ == '__main__':
    main()
