VERSION = '0.33+git'


def cat(filename):
    '''Return contents of file, or empty string if it doesn't exist.'''
    if os.path.exists(filename):
        with open(filename) as f:
            return f.read()
    else:
        return ''


class TestCase(object):

    def __init__(self, name, path_prefix):
        self.name = name
        self.path_prefix = path_prefix


class TestDir(object):

    '''Contain information about a directory of test cases.'''

    per_test_suffixes = ('script', 'stdin', 'stdout', 'stderr',
                         'exit', 'setup', 'teardown')

    def __init__(self):
        self.setup = None
        self.setup_once = None
        self.tests = []
        self.teardown = None
        self.teardown_once = None

    def scan(self, dirname, filenames=None):
        filenames = os.listdir(dirname) if filenames is None else filenames

        script_names = ['setup_once', 'setup', 'teardown', 'teardown_once']
        for name in script_names:
            if name in filenames:
                full_path = os.path.join(dirname, name)
                setattr(self, name, full_path)

        prefixes = self.find_prefixes(filenames)
        for prefix in prefixes:
            test = TestCase(prefix, os.path.join(dirname, prefix))
            for suffix in self.per_test_suffixes:
                name = '%s.%s' % (prefix, suffix)
                if name in filenames:
                    value = os.path.join(dirname, name)
                else:
                    value = None
                setattr(test, suffix, value)
            self.tests.append(test)

    def find_prefixes(self, filenames):
        prefixes = set()
        for filename in filenames:
            for suffix in self.per_test_suffixes:
                suffix = '.' + suffix
                if filename.endswith(suffix):
                    prefix = filename[:-len(suffix)]
                    prefixes.add(prefix)
        return sorted(list(prefixes))


ALL_TESTS = ''
COMPLETE_TEST = ''


class TestFailure(Exception):

    def __init__(self, test, msg):
        self.test = test
        self.msg = msg

    def __str__(self):
        return self.msg


class ScriptError(Exception):

    def __init__(self, script_name, msg):
        self.msg = '%s: %s' % (script_name, msg)

    def __str__(self):
        return self.msg


BOLD = '1'
RED = '31'
GREEN = '32'
YELLOW = '33'
CYAN = '36'


class Reporter:

    """Report test progress and results like pytest does.

    Without verbose, show a dot (or F) per test on a line per test
    directory. With verbose, show each test on a line of its own.

    """

    def __init__(self, output, verbose=False, color=False, width=None):
        self.output = output
        self.verbose = verbose
        self.color = color
        if width is None:
            width = shutil.get_terminal_size().columns
        self.width = width
        self.total = 0
        self.done = 0
        self.failed = 0
        self.dirname = None
        self.line_len = 0

    def paint(self, text, *codes):
        if not self.color or not codes:
            return text
        return '\x1b[%sm%s\x1b[0m' % (';'.join(codes), text)

    def write(self, text, *codes):
        self.output.write(self.paint(text, *codes))
        self.output.flush()
        if '\n' in text:
            self.line_len = len(text) - text.rindex('\n') - 1
        else:
            self.line_len += len(text)

    def sep(self, char, title, *codes):
        title = ' %s ' % title
        n = max(self.width - 1 - len(title), 2)
        left = char * (n // 2)
        right = char * (n - n // 2)
        self.write(left + title + right, *codes)
        self.write('\n')

    def main_color(self):
        return RED if self.failed else GREEN

    def end_line(self):
        if not self.line_len:
            return
        percent = '[%3d%%]' % (100 * self.done // max(self.total, 1))
        pad = self.width - 1 - self.line_len - len(percent)
        self.write(' ' * max(pad, 1))
        self.write(percent, self.main_color())
        self.write('\n')

    def start(self, tests):
        self.total = len(tests)
        self.sep('=', 'test session starts', BOLD)
        self.write('platform %s -- Python %s, cmdspecs %s\n' %
                   (sys.platform, platform.python_version(), VERSION))
        self.write('collected %d test%s\n' %
                   (self.total, '' if self.total == 1 else 's'), BOLD)
        self.write('\n')

    def test_started(self, test):
        dirname = os.path.dirname(test.path_prefix)
        if self.verbose:
            self.write('%s::%s ' % (dirname, test.name))
        elif dirname != self.dirname:
            self.end_line()
            self.dirname = dirname
            self.write(dirname + ' ')

    def test_finished(self, test, failures):
        if not self.verbose and \
                self.line_len + 1 + len(' [100%]') >= self.width:
            self.end_line()
        self.done += 1
        if failures:
            self.failed += 1
        if self.verbose:
            if failures:
                self.write('FAILED', RED)
            else:
                self.write('PASSED', GREEN)
            self.end_line()
        elif failures:
            self.write('F', RED)
        else:
            self.write('.', GREEN)

    def finish(self, failed, passed, elapsed):
        '''Show failures and the summary.

        failed is a list of (test, failures) pairs.

        '''

        self.end_line()
        if failed:
            self.write('\n')
            self.sep('=', 'FAILURES')
            for test, failures in failed:
                self.sep('_', test.name, RED, BOLD)
                for failure in failures:
                    msg = str(failure)
                    self.write(msg if msg.endswith('\n') else msg + '\n')
            self.sep('=', 'short test summary info', CYAN)
            for test, failures in failed:
                self.write('FAILED', RED)
                self.write(' %s - %s\n' %
                           (test.name, str(failures[0]).splitlines()[0]))

        counts = []
        if failed:
            counts.append('%d failed' % len(failed))
        if passed:
            counts.append('%d passed' % passed)
        if failed:
            color = RED
        elif passed:
            color = GREEN
        else:
            color = YELLOW
        summary = '%s in %.2fs' % (', '.join(counts) or 'no tests ran',
                                   elapsed)
        self.sep('=', summary, color, BOLD)


class CommandTester:

    def make_parser(self):
        parser = argparse.ArgumentParser(
            description='blackbox testing of Unix command line tools',
            prog='cmdspecs'
        )
        parser.add_argument('-c', '--command',
                            help='ignored for backwards compatibility')
        parser.add_argument('-t', '--test', action='append',
                            help='run only TEST '
                                 '(can be given many times)',
                            metavar='TEST')
        parser.add_argument('--timings', action='store_true',
                            help='report how long each test takes')
        parser.add_argument('-k', '--keep', action='store_true',
                            help='keep temporary data on failure')
        parser.add_argument('-v', '--verbose', action='store_true',
                            help='show the name and result of each test')
        parser.add_argument('--color', choices=['auto', 'yes', 'no'],
                            default='auto',
                            help='color the output: auto (the default) '
                                 'colors it on a terminal')
        parser.add_argument('--version', action='version',
                            version='%(prog)s ' + VERSION)
        parser.add_argument('dirnames', nargs='+',
                            help='directories containing tests')
        return parser

    def run(self, argv=None):
        self.output = sys.stdout

        args = self.make_parser().parse_args(argv)

        self.timings = {}
        self.timings[ALL_TESTS] = {}
        suite_started = time.time()

        # Convert args to dict-like access for compatibility
        self.settings = {
            'test': args.test if args.test else [],
            'timings': args.timings,
            'keep': args.keep
        }

        td = self.load_tests(args.dirnames)
        self.setup_reporter(args)
        self.reporter.start(td.tests)

        self.setup_tempdir()
        try:
            failed = self.run_tests(td)
        except ScriptError as e:
            self.reporter.end_line()
            self.cleanup_tempdir()
            sys.exit('cmdspecs: %s' % e)

        keep_tempdir = failed and self.settings['keep']
        if not keep_tempdir:
            self.cleanup_tempdir()

        elapsed = time.time() - suite_started
        self.timings[ALL_TESTS][COMPLETE_TEST] = elapsed

        self.reporter.finish(failed, len(td.tests) - len(failed), elapsed)

        if keep_tempdir:
            self.output.write('Test work area: %s\n' % self.tempdir)

        if self.settings['timings']:
            self.report_timings()

        if failed:
            sys.exit(1)

    def run_tests(self, td):
        '''Run the tests and return a list of (test, failures) pairs.'''
        failed = []
        self.run_script(ALL_TESTS, td.setup_once)
        for test in td.tests:
            self.timings[test.name] = {}
            started = time.time()
            self.reporter.test_started(test)
            try:
                self.run_script(test.name, td.setup)
                failures = self.run_test(test)
                self.run_script(test.name, td.teardown)
            except ScriptError as e:
                failures = [TestFailure(test, str(e))]
            self.reporter.test_finished(test, failures)
            if failures:
                failed.append((test, failures))
            self.timings[test.name][COMPLETE_TEST] = time.time() - started
        self.run_script(ALL_TESTS, td.teardown_once)
        return failed

    def setup_reporter(self, args):
        if args.color == 'auto':
            color = (self.output.isatty() and
                     not os.environ.get('NO_COLOR'))
        else:
            color = args.color == 'yes'
        self.reporter = Reporter(self.output, verbose=args.verbose,
                                 color=color)

    def load_tests(self, dirnames):
        td = TestDir()
        for dirname in dirnames:
            if self.settings['test']:
                filenames = self.find_requested_tests(dirname)
                td.scan(dirname, filenames)
            else:
                td.scan(dirname)
        return td

    def find_requested_tests(self, dirname):
        filenames = []
        for test in self.settings['test']:
            for suffix in TestDir.per_test_suffixes:
                filename = '%s.%s' % (test, suffix)
                if os.path.exists(os.path.join(dirname, filename)):
                    filenames.append(filename)

        basenames = ['setup_once', 'setup', 'teardown', 'teardown_once']
        for basename in basenames:
            filename = os.path.join(dirname, basename)
            if os.path.exists(filename):
                filenames.append(basename)

        return filenames

    def setup_tempdir(self):
        self.tempdir = tempfile.mkdtemp()
        logging.info('Temporary directory %s' % self.tempdir)
        self.datadir = os.path.join(self.tempdir, 'data')
        os.mkdir(self.datadir)

    def cleanup_tempdir(self):
        logging.info('Removing temporary directory %s' % self.tempdir)
        shutil.rmtree(self.tempdir)

    def run_script(self, test_name, script_name):
        logging.debug('run_script: test_name=%s script_name=%s' %
                      (test_name, script_name))
        if script_name:
            started = time.time()
            try:
                subprocess.check_call([script_name],
                                      env=self.add_to_env(test_name))
            except subprocess.CalledProcessError as e:
                raise ScriptError(script_name,
                                  'exited with %d' % e.returncode)
            except OSError as e:
                raise ScriptError(script_name, e.strerror)
            self.timings[test_name][script_name] = time.time() - started

    def add_to_env(self, test_name):
        env = dict(os.environ)
        env['SRCDIR'] = os.getcwd()
        env['DATADIR'] = self.datadir
        env['TESTNAME'] = test_name
        return env

    def run_test(self, test):
        logging.info('Test case: %s' % test.name)

        if not test.script:
            return [TestFailure(test, 'missing %s.script' % test.name)]

        self.run_script(test.name, test.setup)

        argv = [test.script]

        stdout_name = test.path_prefix + '.stdout-actual'
        stderr_name = test.path_prefix + '.stderr-actual'
        with open(stdout_name, 'wb') as stdout:
            with open(stderr_name, 'wb') as stderr:
                if test.stdin:
                    stdin = open(test.stdin, 'rb')
                else:
                    stdin = None
                env = self.add_to_env(test.name)
                run_error = None
                try:
                    result = subprocess.run(argv,
                                            env=env,
                                            stdin=stdin,
                                            stdout=stdout,
                                            stderr=stderr,
                                            check=False)
                    exit_code = result.returncode
                except OSError as e:
                    run_error = e
                if stdin is not None:
                    stdin.close()

        self.run_script(test.name, test.teardown)

        if run_error:
            # Comparing output and exit code is pointless when the
            # script never ran.
            return [TestFailure(test, 'could not run %s: %s' %
                                (test.script, run_error.strerror))]

        errors = []

        stdout_diff_name = test.path_prefix + '.stdout-diff'
        stdout_diff = self.diff(test.stdout or '/dev/null', stdout_name,
                                stdout_diff_name)
        if stdout_diff:
            errors.append(TestFailure(test,
                                      'stdout diff:\n%s' % stdout_diff))

        stderr_diff_name = test.path_prefix + '.stderr-diff'
        stderr_diff = self.diff(test.stderr or '/dev/null', stderr_name,
                                stderr_diff_name)
        if stderr_diff:
            errors.append(TestFailure(test,
                                      'stderr diff:\n%s' % stderr_diff))

        contents = cat(test.exit or '/dev/null')
        expected_exit = int(contents.strip() or '0')
        if exit_code != expected_exit:
            errors.append(TestFailure(test,
                                      'got exit code %s, expected %s' %
                                      (exit_code, expected_exit)))

        if not errors:
            os.remove(stdout_name)
            os.remove(stderr_name)
            os.remove(stdout_diff_name)
            os.remove(stderr_diff_name)

        return errors

    def diff(self, expected_name, actual_name, diff_name):
        # Compare bytes, as the output need not be valid UTF-8. Keep
        # the newlines, so that a missing one at the end is a difference.
        try:
            with open(expected_name, 'rb') as f:
                expected_lines = f.readlines()
        except FileNotFoundError:
            expected_lines = []

        try:
            with open(actual_name, 'rb') as f:
                actual_lines = f.readlines()
        except FileNotFoundError:
            actual_lines = []

        # Like diff -u, mark a last line without a newline. Show invalid
        # UTF-8 as backslash escapes.
        diff_lines = []
        for line in difflib.diff_bytes(difflib.unified_diff,
                                       expected_lines,
                                       actual_lines,
                                       fromfile=os.fsencode(expected_name),
                                       tofile=os.fsencode(actual_name),
                                       lineterm=b'\n'):
            if not line.endswith(b'\n'):
                line += b'\n\\ No newline at end of file\n'
            diff_lines.append(line.decode('utf-8', 'backslashreplace'))

        # Add timestamps to headers to match diff -u behavior
        if diff_lines:
            # Get file modification times
            expected_mtime = ''
            actual_mtime = ''

            try:
                from datetime import datetime
                expected_stat = os.stat(expected_name)
                dt = datetime.fromtimestamp(expected_stat.st_mtime)
                expected_mtime = dt.strftime('\t%Y-%m-%d %H:%M:%S.%f +0000')
            except (OSError, FileNotFoundError):
                expected_mtime = '\t2025-01-01 00:00:00.000000 +0000'

            try:
                from datetime import datetime
                actual_stat = os.stat(actual_name)
                dt = datetime.fromtimestamp(actual_stat.st_mtime)
                actual_mtime = dt.strftime('\t%Y-%m-%d %H:%M:%S.%f +0000')
            except (OSError, FileNotFoundError):
                actual_mtime = '\t2025-01-01 00:00:00.000000 +0000'

            # Replace the headers with timestamp versions
            if diff_lines[0].startswith('--- '):
                diff_lines[0] = (diff_lines[0].rstrip('\n') +
                                 expected_mtime + '\n')
            if len(diff_lines) > 1 and diff_lines[1].startswith('+++ '):
                diff_lines[1] = (diff_lines[1].rstrip('\n') +
                                 actual_mtime + '\n')

        # Write diff to file
        with open(diff_name, 'w') as f:
            f.writelines(diff_lines)

        # Return diff content as string
        return ''.join(diff_lines)

    def report_timings(self):

        def report(key, title):
            t = self.timings[key]
            self.output.write('  %s: %.1f s\n' % (title, t[COMPLETE_TEST]))

            items = [(t[x], x) for x in t.keys() if x != COMPLETE_TEST]
            for secs, script in sorted(items):
                self.output.write('    %4.1f %s\n' % (secs, script))

        self.output.write('Timings (in seconds):\n')
        report(ALL_TESTS, 'whole test suite')
        for name in sorted(x for x in self.timings.keys() if x != ALL_TESTS):
            report(name, name)


if __name__ == '__main__':
    CommandTester().run()
