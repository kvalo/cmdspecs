#
# Run the tests and print which lines of cmdspecs they did not run.
# Arguments are passed to ./check. Requires pytest-cov.
#
# --data-file FILE keeps the data of the run in FILE, for combining the
# data of several systems. When FILE exists, the data of this run is
# added to it.

set -eu

data_file=
n=$#
while [ "$n" -gt 0 ]; do
    if [ "$1" = "--data-file" ]; then
        if [ "$n" -lt 2 ]; then
            echo "coverage: --data-file needs a file name" >&2
            exit 64
        fi
        data_file=$2
        shift 2
        n=$((n - 2))
    else
        set -- "$@" "$1"
        shift
        n=$((n - 1))
    fi
done

if ! python3 -c 'import pytest_cov' 2> /dev/null; then
    echo "coverage: pytest-cov is missing" >&2
    exit 1
fi

# In the Git Bash of Windows the paths are MSYS paths (/d/a/...), but
# Python is a Windows program and coverage compares the paths which it
# gets with D:/a/... of Python.
case "$(uname -s)" in
    MINGW* | MSYS*)
        native() { cygpath -m "$1"; }
        ;;
    *)
        native() { printf '%s\n' "$1"; }
        ;;
esac

srcdir=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# cmdspecs has no .py extension, so --cov can't name it as a source,
# but include can.
cat > "$tmp/rc" << RC
[run]
branch = True
data_file = $(native "$tmp/.coverage")
include = $(native "$srcdir/cmdspecs")
# Where coverage has no compiled tracer, as on FreeBSD, every process
# would warn about it on stderr, which the tests compare.
disable_warnings = no-ctracer
RC

# tests/test_specs.py runs cmdspecs as a new process. pytest-cov
# before 7.0 measures those by itself, from 7.0 on coverage does it
# with patch.
if python3 -c 'import sys, pytest_cov
sys.exit(int(pytest_cov.__version__.split(".")[0]) < 7)'; then
    echo "patch = subprocess" >> "$tmp/rc"
fi

# pytest-cov erases the data of earlier runs without --cov-append.
append=
if [ -n "$data_file" ] && [ -e "$data_file" ]; then
    cp "$data_file" "$tmp/.coverage"
    append=--cov-append
fi

status=0
"$srcdir/check" --cov --cov-config="$(native "$tmp/rc")" \
    --cov-report=term-missing $append "$@" || status=$?
if [ -n "$data_file" ]; then
    cp "$tmp/.coverage" "$data_file"
fi
exit $status
